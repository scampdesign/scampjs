{
  "name": "scampjs",
  "version": "0.1.0",
  "description": "The Scamp framework: structure, styles, and logic in separate files, on Vite, Preact, and Hono. Contract 1: scamp dev, /_views/, the readiness line, and the templates export.",
  "license": "MIT",
  "author": "Angie Hemans",
  "homepage": "https://github.com/scampdesign/scampjs#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scampdesign/scampjs.git",
    "directory": "packages/framework"
  },
  "bugs": "https://github.com/scampdesign/scampjs/issues",
  "keywords": [
    "scamp",
    "preact",
    "vite",
    "hono",
    "framework",
    "design-tool"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "default": "./dist/runtime/index.js"
    },
    "./templates": {
      "types": "./dist/templates/index.d.ts",
      "default": "./dist/templates/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "dist",
    "CONTRACT.md",
    "LICENSE",
    "fixtures"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scampjs": {
    "contract": 1
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "node ../../scripts/prepack.mjs CONTRACT.md LICENSE"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "hono": "^4.13.7",
    "preact-render-to-string": "^6.7.0",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "preact": "^10.29.8"
  },
  "bin": {
    "scamp": "bin/scamp.js"
  },
  "peerDependencies": {
    "preact": ">=10.29.0"
  }
}
